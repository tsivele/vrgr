# ─────────────────────────────────────────────────────────────
#  VRGR — Reels Viral Intelligence (Greek market)
#  Αντίγραψέ το σε .env και συμπλήρωσε.  ΤΟ .env ΕΙΝΑΙ GITIGNORED.
# ─────────────────────────────────────────────────────────────

# --- ΥΠΟΧΡΕΩΤΙΚΑ ---------------------------------------------
# HikerAPI  → https://hikerapi.com   (header: x-access-key)
HIKER_API_KEY=

# Anthropic → vision + generation
ANTHROPIC_API_KEY=

# --- ΜΟΝΤΕΛΑ -------------------------------------------------
VRGR_VISION_MODEL=claude-opus-5
VRGR_WRITER_MODEL=claude-opus-5
VRGR_FAST_MODEL=claude-haiku-4-5

# --- HIKERAPI ------------------------------------------------
HIKER_BASE_URL=https://api.hikerapi.com
# fallback χωρίς Cloudflare: https://api.instagrapi.com
HIKER_FALLBACK_URL=https://api.instagrapi.com
HIKER_TIMEOUT_S=60
HIKER_MAX_RETRIES=3
HIKER_RATE_LIMIT_RPS=3
# Ανώτατο πλήθος κλήσεων HikerAPI ανά ΜΙΑ ανάλυση (προστασία credits)
HIKER_BUDGET_PER_RUN=120
# TTL cache ανά οικογένεια endpoint (λεπτά)
HIKER_CACHE_TTL_PROFILE_MIN=720
HIKER_CACHE_TTL_MEDIA_MIN=1440
HIKER_CACHE_TTL_SEARCH_MIN=180
HIKER_CACHE_TTL_HASHTAG_MIN=360

# --- EMBEDDINGS ----------------------------------------------
# local | voyage | openai
VRGR_EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
OPENAI_API_KEY=
VRGR_EMBEDDING_MODEL=voyage-3.5

# --- ASR (προαιρετικό· χωρίς αυτό η ανάλυση βασίζεται μόνο σε καρέ) ---
# none | openai | groq
VRGR_ASR_PROVIDER=none
GROQ_API_KEY=

# --- ΑΠΟΘΗΚΕΥΣΗ ----------------------------------------------
VRGR_DATA_DIR=./data
# sqlite | postgres
VRGR_DB_BACKEND=sqlite
VRGR_POSTGRES_DSN=

# --- ΑΓΟΡΑ ---------------------------------------------------
VRGR_MARKET=GR
VRGR_LANGUAGE=el

# --- ΒΙΝΤΕΟ --------------------------------------------------
VRGR_MAX_FRAMES=14
VRGR_HOOK_WINDOW_S=3.0

# --- LOGGING -------------------------------------------------
VRGR_LOG_LEVEL=INFO
# text | json
VRGR_LOG_FORMAT=text
